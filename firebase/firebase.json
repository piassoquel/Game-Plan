{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "gameplan",
      "ignore": ["node_modules", ".git", "*.log"],
      "predeploy": [
        "node -e \"require('fs').copyFileSync('web/js/pricing.mjs','functions/pricing.mjs')\""
      ]
    }
  ],
  "hosting": {
    "site": "gameplan-soquel",
    "public": "web",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [{ "source": "**", "destination": "/index.html" }]
  },
  "emulators": {
    "auth": { "port": 9099 },
    "functions": { "port": 5001 },
    "firestore": { "port": 8080 },
    "hosting": { "port": 5000 },
    "ui": { "enabled": true },
    "singleProjectMode": true
  }
}
